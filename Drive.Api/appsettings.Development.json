{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=drive_db;Username=YOUR_POSTGRES_USER;Password=YOUR_POSTGRES_PASSWORD",
    "Redis": "localhost:6379"
  },
  "S3": {
    "ServiceUrl": "http://localhost:8333",
    "AccessKey": "YOUR_S3_ACCESS_KEY",
    "SecretKey": "YOUR_S3_SECRET_KEY",
    "BucketName": "drive"
  },
  "Email": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": 587,
    "SenderEmail": "noreply@drive.com",
    "SenderName": "Drive",
    "Username": "YOUR_MAILTRAP_USERNAME",
    "Password": "YOUR_MAILTRAP_PASSWORD",
    "EnableSsl": true,
    "ClientAppUrl": "http://localhost:5173"
  },
  "JwtOptions": {
    "SecretKey": "YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
    "Issuer": "DriveApi",
    "Audience": "DriveClient",
    "ExpirationInMinutes": 60
  },
  "Stripe": {
    "PublishableKey": "pk_test_your_publishable_key_here",
    "SecretKey": "sk_test_your_secret_key_here",
    "WebhookSecret": "whsec_your_webhook_secret_here",
    "SuccessUrl": "http://localhost:5173/billing/success?session_id={CHECKOUT_SESSION_ID}",
    "CancelUrl": "http://localhost:5173/billing/cancel"
  }
}
